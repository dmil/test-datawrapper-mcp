# Environment variables for Datawrapper MCP Web
# Copy this file to .env and fill in your values.

# (Optional) Pre-configure an OpenRouter API key for all users.
# If set, users won't need to enter their own key in the settings panel.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# (Optional) Pre-configure a Datawrapper API token for all users.
# If set, users won't need to enter their own token in the settings panel.
# Create one at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_TOKEN=

# Datawrapper MCP server URL.
# Falls back to https://datawrapper-mcp.fly.dev/mcp if unset.
MCP_URL=https://datawrapper-mcp-dmil.fly.dev/mcp

# Socrata open data MCP server URL.
# Falls back to the public civicaitools.org demo instance if unset.
# Set to an empty value (SOCRATA_MCP_URL=) to disable Socrata entirely.
# SOCRATA_MCP_URL=https://socrata-mcp.civicaitools.org/mcp

# (Optional) Default model for OpenRouter.
# Defaults to anthropic/claude-haiku-5.5
# MODEL=anthropic/claude-haiku-5.5

# (Optional) Port the web server listens on. Defaults to 3000.
# PORT=3000
